# Salin berkas ini menjadi ".env", lalu ganti nilainya. Jangan unggah .env ke Git.

# Kata sandi database. Pakai huruf dan angka saja (tanpa @ : / ? #), karena nilainya masuk ke alamat koneksi.
POSTGRES_PASSWORD=ganti-dengan-sandi-database

# Akun pemilik, dibuat otomatis saat aplikasi pertama kali jalan. Kata sandi minimal 8 karakter.
OWNER_EMAIL=kamu@contoh.id
OWNER_PASSWORD=ganti-dengan-sandi-pemilik
OWNER_NAME=Pemilik

# Port di komputermu untuk membuka aplikasi: http://localhost:8080
APP_PORT=8080

# Isi "true" bila situs dibuka lewat HTTPS, supaya cookie login hanya dikirim lewat HTTPS.
COOKIE_SECURE=false

# Isi "false" untuk menutup pendaftaran akun baru.
ALLOW_REGISTER=true

# Lama sesi login, dalam hari.
SESSION_DAYS=30

# Zona waktu untuk batas hari pada grafik dashboard.
APP_TIMEZONE=Asia/Jakarta

# Tautan tombol "Upgrade ke Premium" di halaman Harga, misalnya https://wa.me/6281234567890
# atau halaman pembayaran. Kosongkan bila aktivasi lewat admin saja.
UPGRADE_URL=

# Isi true bila aplikasi dipasang di belakang Cloudflare Tunnel, Caddy, atau Nginx, supaya pembatas
# percobaan masuk, pendaftaran, dan komentar memakai IP pengunjung. Bila false di belakang proxy, semua
# pengunjung terhitung satu IP: misalnya pendaftaran tertahan setelah 20 akun baru per jam dari seluruh situs.
TRUST_PROXY=false
